# Optional: enables `uv run python run.py --llm` (LLM-polished memo prose).
# Provide ONE of the two keys. Without a key the pipeline runs fully offline
# with deterministic template memos.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
